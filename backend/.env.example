PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://dexline:dexline_dev_password@localhost:5432/dexline_store?schema=public
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:3000
WHATSAPP_NUMBER=911234567890

# --- Application URL -------------------------------------------------------
# Base URL used to build outbound links (email verification links). Should
# be the customer-facing frontend URL. Falls back to CLIENT_ORIGIN if unset.
APP_URL=http://localhost:3000

# --- Cloudflare Turnstile (human verification before registration) --------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and put its keys here. The site key also goes in frontend/.env.local as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. Leave TURNSTILE_SECRET_KEY empty to make
# registration fail closed with a clear "not configured" error rather than
# silently skipping verification.
TURNSTILE_SECRET_KEY=
# Optional: reject tokens solved on any hostname other than this one
# (Cloudflare returns the solving hostname in the siteverify response).
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_GRANT_EXPIRY_MINUTES=10

# --- Outbound email (SMTP) -------------------------------------------------
# Works with any SMTP relay: SendGrid, Mailgun, Amazon SES, Postmark, or a
# real mailbox. Leave blank in development to use the console fallback
# (logs the email instead of sending it — never used when NODE_ENV=production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Dexline Store
EMAIL_FROM_ADDRESS=no-reply@dexline.store
SUPPORT_EMAIL=support@dexline.store
EMAIL_VERIFICATION_EXPIRY_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- SMS OTP via Twilio Verify ---------------------------------------------
# https://www.twilio.com/docs/verify — create a Verify Service and put its
# SID below. Twilio Verify manages OTP generation/expiry/attempts itself.
# Leave blank in development to use the console fallback (logs the code
# instead of sending an SMS — refuses to run at all when NODE_ENV=production).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_OTP_EXPIRY_MINUTES=5
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_ATTEMPTS=5
SMS_MAX_SENDS_PER_DAY=5

# Secret used to keyed-hash locally-generated OTP codes in the dev-only SMS
# console fallback (irrelevant once Twilio is configured). Falls back to
# JWT_SECRET if unset — set a distinct value in any real deployment.
OTP_HASH_SECRET=change-this-to-a-long-random-secret

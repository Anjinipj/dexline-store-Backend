{
  "name": "dexline-store-backend",
  "version": "1.0.0",
  "description": "Dexline Store API - Express + PostgreSQL (Prisma) backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.13",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.19.1",
    "slugify": "^1.6.6",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config"
    ],
    "testTimeout": 15000
  }
}

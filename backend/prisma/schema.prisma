generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum OrderNotificationType {
  order_confirmed
}

enum OrderNotificationStatus {
  queued
  sending
  sent
  failed
}

// `pending_verification` customers have identical access to `active` ones
// everywhere except the frontend's post-signup nudge screen — this only
// gates the account's own verification-status display, never cart, wishlist,
// or checkout. See backend/src/services/verificationService.js.
enum AccountStatus {
  pending_verification
  active
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  passwordHash   String
  phone          String        @default("")
  addressLine1   String        @default("")
  addressLine2   String        @default("")
  addressCity    String        @default("")
  addressState   String        @default("")
  addressPincode String        @default("")
  role           Role          @default(customer)
  // Defaults to `active` so every pre-existing row is backfilled as active
  // (preserving legacy access) the moment this column is added; only new
  // registrations explicitly set `pending_verification`.
  status         AccountStatus @default(active)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  // Set while a verified email/phone change is awaiting confirmation of the
  // NEW value — the old, still-verified value stays live in `email`/`phone`
  // (and usable for login/recovery) until the pending one is confirmed.
  pendingEmail   String?
  pendingPhone   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  cart                    Cart?
  orders                  Order[]                  @relation("OrderCustomer")
  paymentConfirmedOrders  Order[]                  @relation("OrderPaymentConfirmedBy")
  statusHistoryChanges    OrderStatusHistory[]
  wishlistItems           WishlistItem[]
  emailVerificationTokens EmailVerificationToken[]
  phoneVerifications      PhoneVerification[]
}

// Short-lived, single-use proof that a real visitor passed Cloudflare
// Turnstile immediately before submitting the registration form. Not tied
// to a user (none exists yet at that point) — just a random id the
// register endpoint must present and atomically consume.
model TurnstileGrant {
  id         String    @id @default(uuid())
  ip         String    @default("")
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

// One row per email verification link sent. Bound to the exact address
// being verified (`email`), not just the user, so a later change to a
// different address can never be confirmed by an old token for a
// different value. `tokenHash` stores only a SHA-256 hash of the random
// token that goes out in the email — never the raw token.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// One row per OTP challenge. When `provider` is "twilio", Twilio Verify
// owns the actual code and `codeHash` stays empty — `providerRef` (the
// Verify SID) is kept only for bookkeeping. When `provider` is "console"
// (dev-only fallback, see smsProvider.js), `codeHash` holds a keyed HMAC
// of the code — never the plaintext code.
model PhoneVerification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  provider    String
  providerRef String    @default("")
  codeHash    String    @default("")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String     @default("")
  imageUrl    String     @default("")
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryParent")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]

  @@index([parentId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String    @default("")
  description String    @default("")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive])
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  // Treated as VAT-exclusive (net of tax) throughout checkout — see
  // backend/src/config/pricing.js. No inclusive/exclusive marker existed
  // before this field's checkout math was introduced; this is the documented
  // convention, not a fact recovered from prior data.
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  images         String[] @default([])
  description    String   @default("")
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

model Coupon {
  id             String     @id @default(uuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  isActive       Boolean    @default(true)
  expiresAt      DateTime?
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  orders         Order[]
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                   String    @id @default(uuid())
  orderNumber          String    @unique
  customerId           String
  customer             User      @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  customerName         String
  customerPhone        String
  shipLine1            String    @default("")
  shipLine2            String    @default("")
  shipCity             String    @default("")
  shipState            String    @default("")
  shipPincode          String    @default("")
  status               String    @default("Pending Confirmation")
  subtotalAmount       Decimal   @db.Decimal(10, 2)
  discountAmount       Decimal   @db.Decimal(10, 2) @default(0)
  // Flat per-order charge (see config/pricing.js), added before VAT.
  // Defaults to 0 so orders placed before this column existed are left
  // exactly as they were — never recomputed.
  handlingAmount       Decimal   @db.Decimal(10, 2) @default(0)
  // subtotalAmount - discountAmount + handlingAmount — the VAT base.
  taxableAmount        Decimal   @db.Decimal(10, 2) @default(0)
  // VAT rate actually applied at checkout, snapshotted per order so a later
  // change to config/pricing.js never alters how a past order reads.
  vatRate              Decimal   @db.Decimal(5, 4) @default(0)
  // VAT amount (taxableAmount * vatRate, rounded to the nearest fils).
  taxAmount            Decimal   @db.Decimal(10, 2) @default(0)
  shippingAmount       Decimal   @db.Decimal(10, 2) @default(0)
  totalAmount          Decimal   @db.Decimal(10, 2)
  couponId             String?
  coupon               Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode           String    @default("")
  whatsappSentAt       DateTime?
  paymentConfirmedAt   DateTime?
  paymentConfirmedById String?
  paymentConfirmedBy   User?     @relation("OrderPaymentConfirmedBy", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  notes                String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  invoice       Invoice?
  notifications OrderNotification[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// Transactional-outbox row for order-related emails. Created in the SAME
// DB transaction as the status update that triggers it (see
// orderService.updateOrderStatus), so a committed status change can never
// silently lose its notification — a background poller
// (notificationService.dispatchPending) picks up anything still `queued`
// or due for retry and actually sends it. @@unique([orderId, type]) is the
// idempotency guarantee: at most one row can ever exist per order+type, so
// re-confirming, concurrent admin clicks, or the poller running twice can
// never create a second send for the same event — only the explicit
// admin "Resend" action reuses (resets) this same row.
model OrderNotification {
  id                String                   @id @default(uuid())
  orderId           String
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type              OrderNotificationType
  status            OrderNotificationStatus  @default(queued)
  attempts          Int                      @default(0)
  maxAttempts       Int                      @default(5)
  lastError         String                   @default("")
  providerMessageId String                   @default("")
  nextAttemptAt     DateTime                 @default(now())
  sentAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([orderId, type])
  @@index([status, nextAttemptAt])
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  image     String   @default("")

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  changedAt   DateTime @default(now())
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Banner {
  id          String   @id @default(uuid())
  images      String[] @default([])
  badge       String   @default("")
  title       String
  description String   @default("")
  buttonText  String   @default("Shop Now")
  linkHref    String   @default("/#catalog")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
